---
import { NAV, SITE } from '@/lib/site-config';
---

<header class="sticky top-0 z-50 border-b border-border bg-paper/90 backdrop-blur dark:border-[#26282c] dark:bg-night/90">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="/" class="flex items-baseline gap-2">
      <span class="text-lg font-bold tracking-tight">{SITE.shortTitle}</span>
      <span class="hidden font-mono text-[11px] uppercase tracking-[0.2em] text-graphite sm:inline">
        把想法落地成作品
      </span>
    </a>
    <nav class="hidden items-center gap-7 md:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class="text-sm text-graphite transition-colors hover:text-ink dark:text-nighttext/70 dark:hover:text-nighttext"
            set:aria-current={Astro.url.pathname === item.href ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <button
        id="theme-toggle"
        class="rounded-full border border-border px-3 py-1 text-sm transition-colors hover:border-ink dark:border-[#26282c] dark:hover:border-nighttext"
        aria-label="切换深色模式"
      >
        深色
      </button>
    </nav>
    <button
      id="menu-toggle"
      class="flex h-10 w-10 flex-col items-center justify-center gap-1.5 md:hidden"
      aria-label="打开菜单"
      aria-expanded="false"
    >
      <span class="h-px w-6 bg-ink dark:bg-nighttext"></span>
      <span class="h-px w-6 bg-ink dark:bg-nighttext"></span>
      <span class="h-px w-6 bg-ink dark:bg-nighttext"></span>
    </button>
  </div>
  <nav id="mobile-menu" class="hidden border-t border-border bg-paper px-5 py-4 md:hidden dark:border-[#26282c] dark:bg-night">
    <div class="flex flex-col gap-4">
      {
        NAV.map((item) => (
          <a href={item.href} class="text-base text-ink dark:text-nighttext">
            {item.label}
          </a>
        ))
      }
      <button id="theme-toggle-mobile" class="text-left text-base text-graphite dark:text-nighttext/70">
        切换深色模式
      </button>
    </div>
  </nav>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  menuToggle?.addEventListener('click', () => {
    const open = mobileMenu?.classList.toggle('hidden') === false;
    menuToggle.setAttribute('aria-expanded', String(open));
  });

  const applyTheme = (dark: boolean) => {
    document.documentElement.classList.toggle('dark', dark);
    localStorage.setItem('wyx-theme', dark ? 'dark' : 'light');
  };
  const toggleTheme = () => {
    const dark = !document.documentElement.classList.contains('dark');
    applyTheme(dark);
  };
  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);
</script>
