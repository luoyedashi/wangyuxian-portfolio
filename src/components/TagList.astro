---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="flex flex-wrap gap-2">
  {
    tags.map((tag) => (
      <span class="rounded-full bg-grey1 px-3 py-1 text-xs text-graphite dark:bg-[#181a1e] dark:text-nighttext/60">
        #{tag}
      </span>
    ))
  }
</div>
