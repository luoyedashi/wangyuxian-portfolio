---
interface Props {
  index: string;
  title: string;
  subtitle?: string;
}

const { index, title, subtitle } = Astro.props;
---

<div class="mb-8">
  <p class="font-mono text-xs uppercase tracking-[0.25em] text-accent">{index}</p>
  <h2 class="mt-2 text-2xl font-bold tracking-tight md:text-3xl">{title}</h2>
  {
    subtitle && (
      <p class="mt-3 max-w-2xl text-graphite dark:text-nighttext/60">{subtitle}</p>
    )
  }
</div>
