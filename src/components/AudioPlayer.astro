---
interface Props {
  audio?: string;
  title: string;
}

const { audio, title } = Astro.props;
---

{
  audio ? (
    <audio controls preload="none" class="w-full" src={audio}>
      您的浏览器不支持音频播放。
    </audio>
  ) : (
    <div class="overflow-hidden rounded-xl border border-border bg-grey1 dark:border-[#26282c] dark:bg-[#101114]">
      <img src="/images/og/placeholder-audio.svg" alt="音频整理中" class="w-full" loading="lazy" />
      <div class="flex items-center justify-between gap-3 border-t border-border px-5 py-3 dark:border-[#26282c]">
        <p class="text-sm font-medium">{title}</p>
        <span class="font-mono text-xs text-graphite dark:text-nighttext/50">音频整理中</span>
      </div>
    </div>
  )
}
