---
interface Props {
  text: string;
  tone?: 'accent' | 'amber' | 'grey';
}

const { text, tone = 'grey' } = Astro.props;
const tones = {
  accent: 'border-accent/30 bg-accent/5 text-accent dark:text-[#7d9cff]',
  amber: 'border-amber/40 bg-amber/10 text-[#b45309] dark:text-amber',
  grey: 'border-border bg-grey1 text-graphite dark:border-[#26282c] dark:bg-[#181a1e] dark:text-nighttext/60',
};
---

<span
  class={`inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs ${tones[tone]}`}
>
  {text}
</span>
