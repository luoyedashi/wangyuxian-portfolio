---
import { WORK_CATEGORIES } from '@/lib/site-config';

interface Props {
  active?: string;
}

const { active = 'all' } = Astro.props;
---

<div id="filter-tabs" class="flex flex-wrap gap-2" data-active={active}>
  <button
    data-filter="all"
    class="filter-btn rounded-full border px-4 py-1.5 text-sm transition-colors"
    data-active={active === 'all' ? 'true' : 'false'}
  >
    全部
  </button>
  {
    WORK_CATEGORIES.map((c) => (
      <button
        data-filter={c.slug}
        class="filter-btn rounded-full border px-4 py-1.5 text-sm transition-colors"
        data-active={active === c.slug ? 'true' : 'false'}
      >
        {c.label}
      </button>
    ))
  }
</div>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');
  const applyFilter = (filter: string) => {
    cards.forEach((card) => {
      const show = filter === 'all' || card.dataset.category === filter;
      card.style.display = show ? '' : 'none';
    });
    tabs.forEach((tab) => {
      const isActive = tab.dataset.filter === filter;
      tab.dataset.active = String(isActive);
      tab.className = `filter-btn rounded-full border px-4 py-1.5 text-sm transition-colors ${
        isActive
          ? 'border-ink bg-ink text-paper dark:border-nighttext dark:bg-nighttext dark:text-night'
          : 'border-border text-graphite hover:border-ink hover:text-ink dark:border-[#26282c] dark:text-nighttext/60 dark:hover:border-nighttext dark:hover:text-nighttext'
      }`;
    });
  };
  tabs.forEach((tab) => {
    tab.addEventListener('click', () => applyFilter(tab.dataset.filter ?? 'all'));
  });
</script>
