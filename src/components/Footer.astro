---
import { NAV, SITE } from '@/lib/site-config';
---

<footer class="border-t border-border bg-grey1 dark:border-[#26282c] dark:bg-[#101114]">
  <div class="mx-auto max-w-6xl px-5 py-12">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div>
        <p class="text-lg font-bold">{SITE.shortTitle}</p>
        <p class="mt-2 max-w-xs text-sm text-graphite dark:text-nighttext/60">
          水利水电学院学生 · 校园主播「望川客」 · 策划与影像实践者
        </p>
        <p class="mt-3 font-mono text-xs uppercase tracking-[0.2em] text-accent">
          把想法落地成作品
        </p>
      </div>
      <nav class="grid grid-cols-2 gap-x-10 gap-y-2 text-sm">
        {
          NAV.map((item) => (
            <a href={item.href} class="text-graphite hover:text-ink dark:text-nighttext/60 dark:hover:text-nighttext">
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="text-sm text-graphite dark:text-nighttext/60">
        <p><a href={`mailto:${SITE.email}`} class="hover:text-ink dark:hover:text-nighttext">{SITE.email}</a></p>
        <p class="mt-1"><a href={SITE.github} target="_blank" rel="noopener" class="hover:text-ink dark:hover:text-nighttext">GitHub · {SITE.githubHandle}</a></p>
      </div>
    </div>
    <div class="mt-10 border-t border-border pt-5 text-xs text-graphite dark:border-[#26282c] dark:text-nighttext/40">
      © 2026 王钰贤 · 把想法落地成作品
    </div>
  </div>
</footer>
