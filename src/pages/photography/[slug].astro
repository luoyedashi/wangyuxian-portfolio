---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Gallery from '@/components/Gallery.astro';
import TagList from '@/components/TagList.astro';
import { PHOTO_CATEGORY_LABEL } from '@/lib/site-config';

export async function getStaticPaths() {
  const galleries = await getCollection('photography');
  return galleries
    .filter((g) => g.data.privacy.approved)
    .map((g) => ({
      params: { slug: g.data.slug },
      props: { gallery: g },
    }));
}

const { gallery } = Astro.props;
const { Content } = await render(gallery);
const categoryLabel = PHOTO_CATEGORY_LABEL[gallery.data.category] ?? gallery.data.category;
const all = (await getCollection('photography')).filter((g) => g.data.privacy.approved);
const currentIndex = all.findIndex((g) => g.data.slug === gallery.data.slug);
const nextGallery = all[(currentIndex + 1) % all.length];
---

<BaseLayout title={`${gallery.data.title} | 摄影画廊`} description={gallery.data.summary} ogImage={gallery.data.cover}>
  <article class="mx-auto max-w-5xl px-5 py-12">
    <nav class="text-sm text-graphite dark:text-nighttext/50">
      <a href="/photography" class="hover:text-accent dark:hover:text-[#7d9cff]">摄影画廊</a>
      <span class="mx-2">/</span>
      <span>{categoryLabel}</span>
    </nav>
    <h1 class="mt-4 text-3xl font-bold tracking-tight md:text-4xl">{gallery.data.title}</h1>
    <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-graphite dark:text-nighttext/50">
      <span>{gallery.data.date}</span>
      {gallery.data.location && <span>{gallery.data.location}</span>}
    </div>

    <div class="mt-8 overflow-hidden rounded-2xl border border-border dark:border-[#26282c]">
      <img src={gallery.data.cover} alt={gallery.data.title} class="aspect-video w-full object-cover" />
    </div>

    <div class="prose-body mx-auto mt-10 max-w-3xl">
      <Content />
    </div>

    <div class="mt-12">
      <Gallery images={gallery.data.images} />
    </div>

    <div class="mt-10">
      <TagList tags={gallery.data.tags} />
    </div>

    <div class="mt-14 border-t border-border pt-8 dark:border-[#26282c]">
      <a
        href={`/photography/${nextGallery.data.slug}`}
        class="group flex items-center justify-between rounded-xl border border-border p-5 transition-colors hover:border-accent dark:border-[#26282c] dark:hover:border-[#7d9cff]"
      >
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-graphite dark:text-nighttext/40">下一专题</p>
          <p class="mt-1 font-semibold group-hover:text-accent dark:group-hover:text-[#7d9cff]">
            {nextGallery.data.title}
          </p>
        </div>
        <span class="text-xl">→</span>
      </a>
    </div>
  </article>
</BaseLayout>
