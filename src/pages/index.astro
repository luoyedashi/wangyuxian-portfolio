---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import WorkCard from '@/components/WorkCard.astro';
import VoiceCard from '@/components/VoiceCard.astro';
import Timeline from '@/components/Timeline.astro';
import { SITE } from '@/lib/site-config';

const works = (await getCollection('works'))
  .filter((w) => w.data.status === 'public' && w.data.privacy.approved)
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
const featured = works.filter((w) => w.data.featured).slice(0, 6);
const episodes = (await getCollection('voice')).filter((v) => v.data.privacy.approved);
const galleries = (await getCollection('photography')).filter((p) => p.data.privacy.approved);
const photoPreview = galleries.slice(0, 4);
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-20 md:grid-cols-[1.2fr_1fr] md:py-28">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-accent dark:text-[#7d9cff]">
          四川大学 · 水利水电学院 · 2025 级
        </p>
        <h1 class="mt-4 text-5xl font-bold tracking-tight md:text-7xl">{SITE.shortTitle}</h1>
        <p class="mt-5 text-lg text-graphite dark:text-nighttext/70 md:text-xl">
          水利水电学院学生 / 校园主播「望川客」 / 策划与影像实践者
        </p>
        <p class="mt-6 max-w-xl text-2xl font-semibold leading-snug md:text-3xl">
          把想法落地成作品。
        </p>
        <p class="mt-3 max-w-xl text-graphite dark:text-nighttext/60">
          用工程思维做事，用声音表达观点，用影像记录生活。
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/works"
            class="rounded-full bg-ink px-7 py-3 text-sm font-medium text-paper transition-colors hover:bg-accent dark:bg-nighttext dark:text-night dark:hover:bg-[#7d9cff]"
          >
            查看作品
          </a>
          <a
            href={SITE.resume}
            download
            class="rounded-full border border-ink px-7 py-3 text-sm font-medium transition-colors hover:bg-ink hover:text-paper dark:border-nighttext dark:hover:bg-nighttext dark:hover:text-night"
          >
            下载简历
          </a>
        </div>
      </div>
      <div class="relative">
        <div class="overflow-hidden rounded-2xl border border-border dark:border-[#26282c]">
          <img
            src="/images/photography/photo-portrait-01.png"
            alt="王钰贤"
            class="aspect-[4/5] w-full object-cover"
          />
        </div>
        <div class="absolute -bottom-4 -left-4 rounded-xl bg-accent px-5 py-3 text-paper shadow-lg">
          <p class="font-mono text-xs uppercase tracking-widest">望川客 · 声音电台</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 三个身份卡片 -->
  <section class="border-y border-border bg-grey1 dark:border-[#26282c] dark:bg-[#101114]">
    <div class="mx-auto grid max-w-6xl gap-5 px-5 py-14 md:grid-cols-3">
      <div class="rounded-xl border border-border bg-white p-6 dark:border-[#26282c] dark:bg-[#15171a]">
        <p class="font-mono text-xs uppercase tracking-widest text-accent dark:text-[#7d9cff]">01 工程与策划</p>
        <p class="mt-3 text-sm leading-7 text-graphite dark:text-nighttext/60">
          从专业学习到科研预演与商业项目，尝试把问题变成方案。
        </p>
      </div>
      <div class="rounded-xl border border-border bg-white p-6 dark:border-[#26282c] dark:bg-[#15171a]">
        <p class="font-mono text-xs uppercase tracking-widest text-accent dark:text-[#7d9cff]">02 声音与表达</p>
        <p class="mt-3 text-sm leading-7 text-graphite dark:text-nighttext/60">
          在校园广播与公开发言中，练习把观点说清楚。
        </p>
      </div>
      <div class="rounded-xl border border-border bg-white p-6 dark:border-[#26282c] dark:bg-[#15171a]">
        <p class="font-mono text-xs uppercase tracking-widest text-amber">03 摄影与视觉</p>
        <p class="mt-3 text-sm leading-7 text-graphite dark:text-nighttext/60">
          用照片记录校园、旅行与人，留下值得被记住的瞬间。
        </p>
      </div>
    </div>
  </section>

  <!-- 精选作品 -->
  <section class="mx-auto max-w-6xl px-5 py-20">
    <SectionHeading
      index="01"
      title="精选作品"
      subtitle="从科研预演到团学项目，每一件都是「把想法落地成作品」的练习。"
    />
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featured.map((work) => <WorkCard work={work} />)}
    </div>
    <div class="mt-10 text-center">
      <a
        href="/works"
        class="inline-flex items-center gap-2 rounded-full border border-border px-6 py-2.5 text-sm font-medium transition-colors hover:border-ink hover:text-ink dark:border-[#26282c] dark:hover:border-nighttext dark:hover:text-nighttext"
      >
        查看全部作品 →
      </a>
    </div>
  </section>

  <!-- 声音预览 -->
  <section class="border-y border-border bg-grey1 dark:border-[#26282c] dark:bg-[#101114]">
    <div class="mx-auto max-w-6xl px-5 py-20">
      <SectionHeading
        index="02"
        title="声音电台 · 《川雅颂》"
        subtitle="主播「望川客」：在广播里读诗，也在广播里练习把话说清楚。音频整理中，敬请期待。"
      />
      <div class="grid gap-6 sm:grid-cols-2">
        {episodes.map((ep) => <VoiceCard episode={ep} />)}
      </div>
    </div>
  </section>

  <!-- 摄影预览 -->
  <section class="mx-auto max-w-6xl px-5 py-20">
    <SectionHeading
      index="03"
      title="摄影画廊"
      subtitle="光影落在校园、街道与人的脸上——一些我按下快门的理由。"
    />
    <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
      {photoPreview.map((g) => (
        <a href={`/photography/${g.data.slug}`} class="group overflow-hidden rounded-xl">
          <img
            src={g.data.cover}
            alt={g.data.title}
            loading="lazy"
            class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </a>
      ))}
    </div>
    <div class="mt-8">
      <a href="/photography" class="text-sm font-medium text-accent hover:underline dark:text-[#7d9cff]">
        进入摄影画廊 →
      </a>
    </div>
  </section>

  <!-- 时间线 -->
  <section class="mx-auto max-w-6xl px-5 py-20">
    <SectionHeading index="04" title="年度关键行动" />
    <Timeline />
  </section>

  <!-- 联系区 -->
  <section class="mx-auto max-w-6xl px-5 pb-24">
    <div class="rounded-2xl border border-border bg-white p-10 text-center dark:border-[#26282c] dark:bg-[#15171a]">
      <h2 class="text-2xl font-bold md:text-3xl">一起做点什么？</h2>
      <p class="mx-auto mt-3 max-w-xl text-sm text-graphite dark:text-nighttext/60">
        合作方向：校园活动策划 / 摄影拍摄 / 广播主持 / 商业分析 / AI 学习方法 / 水利学习交流
      </p>
      <a
        href="/contact"
        class="mt-7 inline-block rounded-full bg-accent px-8 py-3 text-sm font-medium text-white transition-colors hover:bg-river"
      >
        联系我
      </a>
    </div>
  </section>
</BaseLayout>
