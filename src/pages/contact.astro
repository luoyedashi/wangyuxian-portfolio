---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContactForm from '@/components/ContactForm.astro';
import { SITE } from '@/lib/site-config';

const directions = [
  '校园活动策划',
  '摄影拍摄',
  '广播与主持',
  '商业分析',
  'AI 学习方法',
  '水利专业学习交流',
];
---

<BaseLayout title="联系我 | 王钰贤" description="联系王钰贤：校园活动策划、摄影拍摄、广播主持、商业分析、AI 学习方法、水利学习交流。">
  <section class="mx-auto max-w-6xl px-5 py-16 md:py-20">
    <p class="font-mono text-xs uppercase tracking-[0.3em] text-accent dark:text-[#7d9cff]">Contact</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">联系我</h1>
    <p class="mt-4 max-w-2xl text-graphite dark:text-nighttext/60">
      欢迎交流。如果我的作品或经历对你有启发，或者你正好需要一位愿意把想法落地的伙伴，欢迎通过以下方式联系我。
    </p>

    <div class="mt-12 grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="text-lg font-semibold">合作方向</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {directions.map((d) => (
            <span class="rounded-full border border-border px-4 py-1.5 text-sm text-graphite dark:border-[#26282c] dark:text-nighttext/60">
              {d}
            </span>
          ))}
        </div>

        <div class="mt-10 space-y-5">
          <div class="rounded-xl border border-border bg-white p-5 dark:border-[#26282c] dark:bg-[#15171a]">
            <p class="font-mono text-xs uppercase tracking-widest text-graphite dark:text-nighttext/40">邮箱</p>
            <a href={`mailto:${SITE.email}`} class="mt-1 block font-medium hover:text-accent dark:hover:text-[#7d9cff]">
              {SITE.email}
            </a>
          </div>
          <div class="rounded-xl border border-border bg-white p-5 dark:border-[#26282c] dark:bg-[#15171a]">
            <p class="font-mono text-xs uppercase tracking-widest text-graphite dark:text-nighttext/40">GitHub</p>
            <a href={SITE.github} target="_blank" rel="noopener" class="mt-1 block font-medium hover:text-accent dark:hover:text-[#7d9cff]">
              github.com/{SITE.githubHandle}
            </a>
          </div>
          <div class="rounded-xl border border-border bg-white p-5 dark:border-[#26282c] dark:bg-[#15171a]">
            <p class="font-mono text-xs uppercase tracking-widest text-graphite dark:text-nighttext/40">简历</p>
            <a href={SITE.resume} download class="mt-1 block font-medium text-accent hover:underline dark:text-[#7d9cff]">
              下载简历 PDF
            </a>
          </div>
        </div>
      </div>
      <div>
        <ContactForm />
      </div>
    </div>
  </section>
</BaseLayout>
