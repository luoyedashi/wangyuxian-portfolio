---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import AudioPlayer from '@/components/AudioPlayer.astro';
import TagList from '@/components/TagList.astro';

export async function getStaticPaths() {
  const episodes = await getCollection('voice');
  return episodes
    .filter((v) => v.data.privacy.approved)
    .map((ep) => ({
      params: { slug: ep.data.slug },
      props: { episode: ep },
    }));
}

const { episode } = Astro.props;
const { Content } = await render(episode);
const all = (await getCollection('voice')).filter((v) => v.data.privacy.approved);
const currentIndex = all.findIndex((v) => v.data.slug === episode.data.slug);
const nextEpisode = all[(currentIndex + 1) % all.length];
---

<BaseLayout title={`${episode.data.title} | 声音电台`} description={episode.data.summary} ogImage={episode.data.cover}>
  <article class="mx-auto max-w-3xl px-5 py-12">
    <nav class="text-sm text-graphite dark:text-nighttext/50">
      <a href="/voice" class="hover:text-accent dark:hover:text-[#7d9cff]">声音电台</a>
      <span class="mx-2">/</span>
      <span>{episode.data.program}</span>
    </nav>
    <h1 class="mt-4 text-3xl font-bold tracking-tight md:text-4xl">{episode.data.title}</h1>
    <div class="mt-3 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-graphite dark:text-nighttext/50">
      <span>{episode.data.date}</span>
      {episode.data.duration && <span>时长：{episode.data.duration}</span>}
    </div>
    <p class="mt-6 text-lg leading-relaxed">{episode.data.summary}</p>

    <div class="mt-8">
      <AudioPlayer audio={episode.data.audio} title={episode.data.title} />
    </div>

    <div class="prose-body mt-10 border-t border-border pt-8 dark:border-[#26282c]">
      <Content />
    </div>

    <div class="mt-10">
      <TagList tags={episode.data.tags} />
    </div>

    <div class="mt-14 border-t border-border pt-8 dark:border-[#26282c]">
      <a
        href={`/voice/${nextEpisode.data.slug}`}
        class="group flex items-center justify-between rounded-xl border border-border p-5 transition-colors hover:border-accent dark:border-[#26282c] dark:hover:border-[#7d9cff]"
      >
        <div>
          <p class="font-mono text-xs uppercase tracking-widest text-graphite dark:text-nighttext/40">下一期</p>
          <p class="mt-1 font-semibold group-hover:text-accent dark:group-hover:text-[#7d9cff]">
            {nextEpisode.data.title}
          </p>
        </div>
        <span class="text-xl">→</span>
      </a>
    </div>
  </article>
</BaseLayout>
