---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import VoiceCard from '@/components/VoiceCard.astro';

const episodes = (await getCollection('voice'))
  .filter((v) => v.data.privacy.approved)
  .sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<BaseLayout title="声音电台 | 王钰贤" description="西柚电台《川雅颂》，主播「望川客」：读诗、聊天、练习把话说清楚。">
  <section class="mx-auto max-w-6xl px-5 py-16 md:py-20">
    <p class="font-mono text-xs uppercase tracking-[0.3em] text-accent dark:text-[#7d9cff]">Voice</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">声音电台 · 《川雅颂》</h1>
    <p class="mt-4 max-w-2xl text-graphite dark:text-nighttext/60">
      这里是西柚电台，我是「望川客」。在广播里，我读诗、聊天、练习把话说清楚。
    </p>

    <div class="mt-10 flex flex-col gap-6 rounded-2xl border border-border bg-grey1 p-6 md:flex-row md:items-center dark:border-[#26282c] dark:bg-[#101114]">
      <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-accent text-2xl text-white">
        🎙
      </div>
      <div>
        <p class="text-lg font-semibold">主播 · 望川客</p>
        <p class="mt-1 text-sm text-graphite dark:text-nighttext/60">
          关注诗歌与表达，主动标注前后鼻音，练习普通话的准与表达的真。
        </p>
      </div>
    </div>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {episodes.map((ep) => <VoiceCard episode={ep} />)}
    </div>

    <p class="mt-10 text-sm text-graphite dark:text-nighttext/40">
      音频整理中，敬请期待。节目上线后将在此直接播放。
    </p>
  </section>
</BaseLayout>
