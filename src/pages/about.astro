---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import TagList from '@/components/TagList.astro';
import { SITE } from '@/lib/site-config';

const keywords = [
  '水利方向学生',
  '校园主播「望川客」',
  '团支书',
  '策划实践者',
  '摄影实践者',
  'AI 协作者',
];
---

<BaseLayout title="关于我 | 王钰贤">
  <section class="mx-auto max-w-6xl px-5 py-16 md:py-24">
    <div class="grid gap-12 md:grid-cols-[1fr_2fr]">
      <div>
        <div class="overflow-hidden rounded-2xl border border-border dark:border-[#26282c]">
          <img
            src="/images/photography/photo-campus-03.png"
            alt="王钰贤"
            class="aspect-[4/5] w-full object-cover"
          />
        </div>
        <div class="mt-5">
          <TagList tags={keywords} />
        </div>
      </div>
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.3em] text-accent dark:text-[#7d9cff]">About</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">关于我</h1>
        <div class="prose-body mt-8">
          <p>
            我是王钰贤，来自陕南安康，现在四川大学水利水电学院学习水利科学与工程。
          </p>
          <p>
            我的主线有两条：一条在水边。家乡安康因水而兴、也曾在洪水中重生，祖父一生从事水土保持工作。
            带着这份记忆，我进入水利专业，开始做流域出力预测、堰塞坝与冰碛坝研究相关的学习与预演。
          </p>
          <p>
            另一条在人前。我是西柚电台《川雅颂》的主播「望川客」，也是校团委文化艺术部视听宣传部的一员——
            写推文、做招新系统、参与「凤凰展翅」宣传；2026 年暑假，我随「汉水留声」实践团回到安康，
            专访水利老干部、走进水电厂，把课堂与家乡连在一起。
          </p>
          <p>
            课余我喜欢摄影，拍校园、拍人、拍光影；也喜欢用 AI 辅助学习与做事，
            但始终要求自己：方法可以借助工具，作品必须自己完成。
          </p>
          <p>
            我相信认真、担当与长期主义。这个网站就是我的作品证据库——把想法落地成作品。
          </p>
        </div>
        <div class="mt-10">
          <a
            href={SITE.resume}
            download
            class="inline-block rounded-full bg-ink px-7 py-3 text-sm font-medium text-paper transition-colors hover:bg-accent dark:bg-nighttext dark:text-night dark:hover:bg-[#7d9cff]"
          >
            下载简历
          </a>
        </div>
      </div>
    </div>

    <div class="mt-20">
      <SectionHeading index="01" title="教育经历" />
      <div class="space-y-4">
        <div class="flex flex-col gap-1 border-l-2 border-accent pl-5 dark:border-[#7d9cff]">
          <p class="font-semibold">四川大学 · 水利水电学院 · 水利科学与工程</p>
          <p class="text-sm text-graphite dark:text-nighttext/60">2025.09 – 至今</p>
        </div>
        <div class="flex flex-col gap-1 border-l-2 border-border pl-5 dark:border-[#26282c]">
          <p class="font-semibold">陕西省安康中学高新分校</p>
          <p class="text-sm text-graphite dark:text-nighttext/60">2022.09 – 2025.06 ｜ 曾任学生会主席、电影社社长</p>
        </div>
      </div>
    </div>

    <div class="mt-20">
      <SectionHeading index="02" title="校园经历" />
      <div class="space-y-4">
        <div class="flex flex-col gap-1 border-l-2 border-accent pl-5 dark:border-[#7d9cff]">
          <p class="font-semibold">水利水电学院 202 班 · 团支书</p>
          <p class="text-sm text-graphite dark:text-nighttext/60">2026.07 – 至今 ｜ 曾任组宣委员</p>
        </div>
        <div class="flex flex-col gap-1 border-l-2 border-border pl-5 dark:border-[#26282c]">
          <p class="font-semibold">校团委文化艺术部 · 视听宣传部核心成员</p>
          <p class="text-sm text-graphite dark:text-nighttext/60">2025.10 – 至今 ｜ 推文、招新物料、美育汇报</p>
        </div>
        <div class="flex flex-col gap-1 border-l-2 border-border pl-5 dark:border-[#26282c]">
          <p class="font-semibold">「汉水留声，拾忆烽火」爱国主义教育实践团</p>
          <p class="text-sm text-graphite dark:text-nighttext/60">2026.08 ｜ 统筹组 · 现场讲解</p>
        </div>
      </div>
    </div>

    <div class="mt-20">
      <SectionHeading index="03" title="价值观" />
      <p class="max-w-2xl text-lg leading-8">
        认真、担当、长期主义。面对复杂的问题，先动手把它变成方案；
        面对表达的机会，把观点说清楚；面对想留下的瞬间，按下快门。
      </p>
    </div>
  </section>
</BaseLayout>
