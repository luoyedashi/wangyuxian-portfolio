---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到 | 王钰贤">
  <section class="mx-auto flex max-w-6xl flex-col items-center px-5 py-32 text-center">
    <p class="font-mono text-xs uppercase tracking-[0.3em] text-accent dark:text-[#7d9cff]">404</p>
    <h1 class="mt-4 text-5xl font-bold tracking-tight md:text-6xl">这个页面不存在</h1>
    <p class="mt-5 max-w-md text-graphite dark:text-nighttext/60">
      也许链接写错了，或者内容还没有上线。
    </p>
    <a
      href="/"
      class="mt-9 rounded-full bg-ink px-8 py-3 text-sm font-medium text-paper transition-colors hover:bg-accent dark:bg-nighttext dark:text-night dark:hover:bg-[#7d9cff]"
    >
      返回首页
    </a>
  </section>
</BaseLayout>
